{
  "PlatformName": "RTPSC TAXPRAC Enterprise Suite",
  "DeploymentTarget": "Production",
  "ExecutionPolicies": {
    "CeleryWorkers": {
      "RuntimeLimits": {
        "MaxMemoryMB": 4096,
        "MaxCPUCores": 2,
        "TimeoutSeconds": 120
      },
      "NetworkEgress": {
        "Default": "DENY",
        "AllowedEndpointClasses": [
          "Configured database service",
          "Explicitly authorized provider adapters"
        ],
        "GovernmentAdapters": {
          "Status": "GATED",
          "Rule": "No IRS, Treasury, MeF, TDS, FIRE, A2A, transcript, refund, or other government endpoint may be contacted unless a documented enrolled adapter is separately configured, authenticated, and approved."
        }
      }
    }
  }
}
